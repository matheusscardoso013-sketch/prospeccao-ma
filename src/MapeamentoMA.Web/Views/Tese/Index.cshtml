@model IEnumerable<MapeamentoMA.Web.Models.Tese>
@{ ViewData["Title"] = "Teses Setoriais"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Teses Setoriais</h2>
    <a asp-action="Criar" class="btn btn-primary">+ Nova Tese</a>
</div>

<table class="table table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nome</th>
            <th>CNAEs-alvo</th>
            <th>Faturamento (R$)</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr class="@(t.Ativa ? "" : "table-secondary text-muted")">
                <td>@t.Nome</td>
                <td><small>@t.CnaesAlvo</small></td>
                <td>@t.FaturamentoMin.ToString("N0") – @t.FaturamentoMax.ToString("N0")</td>
                <td>
                    @if (t.Ativa) { <span class="badge bg-success">Ativa</span> }
                    else { <span class="badge bg-secondary">Inativa</span> }
                </td>
                <td class="text-end">
                    <a asp-action="Editar" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                    @if (User.IsInRole("Socio"))
                    {
                        <a asp-action="Desativar" asp-route-id="@t.Id"
                           class="btn btn-sm @(t.Ativa ? "btn-outline-warning" : "btn-outline-success") ms-1">
                            @(t.Ativa ? "Desativar" : "Reativar")
                        </a>
                    }
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center text-muted py-4">Nenhuma tese cadastrada ainda.</td></tr>
        }
    </tbody>
</table>
