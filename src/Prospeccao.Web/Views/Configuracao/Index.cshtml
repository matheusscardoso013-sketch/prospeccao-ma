@model IEnumerable<ConfiguracaoProspeccao>
@{
    ViewData["Title"] = "Configurações de prospecção";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Configurações de prospecção</h1>
    <a class="btn btn-primary" asp-action="Criar">Nova configuração</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Nenhuma configuração ainda. Crie uma definindo os CNAEs, UFs e a faixa de capital social do recorte.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>CNAEs</th>
                <th>UFs</th>
                <th>Capital (mín. – máx.)</th>
                <th>Ativa</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Cnaes</td>
                <td>@c.Ufs</td>
                <td>
                    @(c.CapitalMin?.ToString("C") ?? "—") – @(c.CapitalMax?.ToString("C") ?? "—")
                </td>
                <td>
                    @if (c.Ativo)
                    {
                        <span class="badge bg-success">Sim</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Não</span>
                    }
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@c.Id">Editar</a>
                    <form asp-action="Excluir" asp-route-id="@c.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Excluir esta configuração?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
