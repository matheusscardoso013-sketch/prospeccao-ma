@model ProspeccaoMA.Web.Models.Comprador
@{
    ViewData["Title"] = "Editar comprador";
}

<div class="lead-wrap">
<div class="lead-head">
    <div>
        <div class="px-ey">Editar comprador</div>
        <h1 class="px-h1">Editar comprador</h1>
        <div class="px-sub">Atualize a tese de investimento e os contatos. A tese é o que a IA usa para cruzar com os alvos.</div>
    </div>
    <a class="fa-btn s" style="align-self:flex-start" asp-controller="Comprador" asp-action="Index">← Voltar</a>
</div>

<form asp-controller="Comprador" asp-action="Salvar" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="alert err" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <div class="formgrid">
        <div class="field full">
            <label>Nome</label>
            <input type="text" asp-for="Nome" />
        </div>
        <div class="field">
            <label>Tipo de empresa</label>
            <input type="text" asp-for="TipoEmpresa" placeholder="Fundo, Tecnologia, Indústria…" />
        </div>
        <div class="field">
            <label>Faixa de faturamento alvo</label>
            <input type="text" asp-for="FaixaFaturamento" />
        </div>
        <div class="field full">
            <label>Segmento</label>
            <input type="text" asp-for="Segmento" />
        </div>
        <div class="field full">
            <label>Tags da tese</label>
            <input type="text" asp-for="Tags" placeholder="#saude #fintech #agro" />
        </div>
        <div class="field">
            <label>Responsável (Valore)</label>
            <input type="text" asp-for="Responsavel" />
        </div>
        <div class="field">
            <label>Site</label>
            <input type="text" asp-for="Site" />
        </div>
        <div class="field full">
            <label>Contatos</label>
            <textarea asp-for="Contato" style="min-height:90px" placeholder="Nome, e-mail e telefone dos contatos (um por linha)"></textarea>
            <div class="hint">Pode adicionar vários contatos — um por linha (ex.: João Silva — joao@fundo.com — (11) 99999-0000).</div>
        </div>
        <div class="field full">
            <label>Tese de investimento</label>
            <textarea asp-for="Tese" style="min-height:200px" placeholder="Descreva a tese: setores, ticket, modelo, geografia, critérios…"></textarea>
        </div>

        <div class="full" style="border-top:1px solid var(--line);padding-top:14px">
            <strong>Critérios estruturados</strong>
            <div class="hint">Quando preenchidos, têm prioridade sobre o texto da tese no matching da IA — deixam o score muito mais preciso.</div>
        </div>
        <div class="field">
            <label>Faturamento alvo mínimo (R$/ano)</label>
            <input type="number" step="0.01" asp-for="FaturamentoMinAlvo" placeholder="30000000" />
        </div>
        <div class="field">
            <label>Faturamento alvo máximo (R$/ano)</label>
            <input type="number" step="0.01" asp-for="FaturamentoMaxAlvo" placeholder="120000000" />
        </div>
        <div class="field">
            <label>Margem EBITDA mínima (%)</label>
            <input type="number" step="0.1" asp-for="MargemEbitdaMinima" placeholder="15" />
        </div>
        <div class="field">
            <label>Tipo de operação</label>
            <select asp-for="TipoOperacao">
                <option value="">(não definido)</option>
                <option>Controle</option>
                <option>Minoritária</option>
                <option>100%</option>
                <option>Indiferente</option>
            </select>
        </div>
        <div class="field">
            <label>Geografia alvo</label>
            <input type="text" asp-for="GeografiaAlvo" placeholder="Nacional, Sudeste, SP…" />
        </div>
        <div class="field">
            <label>Modelo de negócio buscado</label>
            <input type="text" asp-for="ModeloNegocioAlvo" placeholder="B2B recorrente; serviços; indústria…" />
        </div>
        <div class="field full">
            <label>Exclusões / red flags (o que NÃO olham — eliminatório no matching)</label>
            <textarea asp-for="Exclusoes" style="min-height:60px" placeholder="ex.: não olham produto/SaaS; sem muitos PJs; não fazem turnaround"></textarea>
        </div>
        <div class="field full">
            <label>Cultura / fit desejado</label>
            <textarea asp-for="Cultura" style="min-height:60px" placeholder="ex.: fundador permanece na operação; gestão profissionalizada; governança"></textarea>
        </div>
        <div class="field">
            <label>Status</label>
            <select asp-for="Ativo">
                <option value="true">Ativo (entra no cruzamento)</option>
                <option value="false">Inativo</option>
            </select>
        </div>
        <div class="full">
            <button type="submit" class="fa-btn p">Salvar comprador</button>
        </div>
    </div>
</form>
</div>
