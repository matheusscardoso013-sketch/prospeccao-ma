@model List<ProspeccaoMA.Web.Models.Comprador>
@{
    ViewData["Title"] = "Compradores";
    string Curto(string? s, int n) => string.IsNullOrWhiteSpace(s) ? "" : (s.Length > n ? s.Substring(0, n) + "…" : s);
    var semTese = (bool)(ViewData["SemTese"] ?? false);
}

<div class="lead-wrap">
    <div class="lead-head">
        <div>
            <div class="px-ey">Buy-side</div>
            <h1 class="px-h1">Compradores</h1>
            <div class="px-sub">Base de compradores da Valore. A IA cruza os leads prospectados com a tese de cada um.</div>
        </div>
        <div style="color:var(--muted);font-size:12px;letter-spacing:.03em;align-self:center;white-space:nowrap">@ViewData["Total"] compradores ativos</div>
    </div>

    <form method="get" asp-controller="Comprador" asp-action="Index" class="lf">
        <div class="field" style="flex:1;min-width:180px">
            <label>Buscar</label>
            <input type="text" name="busca" value="@ViewData["Busca"]" placeholder="nome, tese, setor ou tag (ex.: saúde, fintech, agro)" style="width:100%" />
        </div>
        <div class="field">
            <label>Responsável</label>
            <select name="resp">
                <option value="">Todos</option>
                @foreach (var r in (List<string>)ViewData["Responsaveis"]!)
                {
                    <option value="@r" selected="@(r == (string?)ViewData["Resp"])">@r</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Tipo</label>
            <select name="tipo">
                <option value="">Todos</option>
                @foreach (var t in (List<string>)ViewData["Tipos"]!)
                {
                    <option value="@t" selected="@(t == (string?)ViewData["Tipo"])">@t</option>
                }
            </select>
        </div>
        <button type="submit" class="fa-btn s">Filtrar</button>
        @if (semTese)
        {
            <a class="fa-btn p" asp-controller="Comprador" asp-action="Index">Mostrar todos</a>
        }
        else
        {
            <a class="fa-btn s" style="color:var(--score-lo);border-color:#f0d0d0" asp-controller="Comprador" asp-action="Index" asp-route-semTese="true">⚠ Sem tese (@ViewData["TotalSemTese"])</a>
        }
    </form>

    @if (semTese)
    {
        <div class="alert err">Compradores <strong>sem tese de investimento</strong> registrada — eles ficam <strong>fora do cruzamento com alvos</strong> até a tese ser preenchida (Editar).</div>
    }

    @if (Model.Count == 0)
    {
        <div class="lead-vazio">Nenhum comprador encontrado. Importe a base buy-side para popular esta lista.</div>
    }
    else
    {
        var grupoAtual = -1;
        <div class="lc-grid">
            @foreach (var c in Model)
            {
                var grupo = ProspeccaoMA.Web.Controllers.CompradorController.GrupoCompletude(c);
                if (grupo != grupoAtual)
                {
                    grupoAtual = grupo;
                    <div class="bc-grupo">
                        @(grupo == 0 ? "Prontos para o matching — tese + critérios estruturados"
                          : grupo == 1 ? "Tese só em texto — preencher critérios melhora o score"
                          : "Sem tese — fora do cruzamento até preencher")
                    </div>
                }
                var matches = c.Sinergias.Count;
                <div class="lc">
                    <div class="lc-top">
                        <div class="bc-av">@(string.IsNullOrEmpty(c.Nome) ? "?" : c.Nome.Substring(0, 1).ToUpper())</div>
                        <div class="lc-id">
                            <div class="lc-razao">@c.Nome @if (grupo == 0) { <span class="bc-ok" title="Critérios estruturados preenchidos">critérios ✓</span> }</div>
                            @if (!string.IsNullOrWhiteSpace(c.RazaoSocial)) { <div class="lc-cnpj" style="font-family:inherit">@c.RazaoSocial</div> }
                            <div class="lc-tags">
                                @if (!string.IsNullOrWhiteSpace(c.TipoEmpresa)) { <span class="lc-tag">@c.TipoEmpresa</span> }
                                @if (!string.IsNullOrWhiteSpace(c.Segmento)) { <span class="lc-tag">@Curto(c.Segmento, 40)</span> }
                                @if (!string.IsNullOrWhiteSpace(c.FaixaFaturamento)) { <span class="lc-tag">💰 @Curto(c.FaixaFaturamento, 30)</span> }
                                @if (!string.IsNullOrWhiteSpace(c.Tags))
                                {
                                    foreach (var t in c.Tags.Split(new[] { ' ', ',', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries).Where(x => x.StartsWith("#")).Take(6))
                                    {
                                        <span class="lc-tag hash">@t</span>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="lc-rac" style="margin-top:15px">
                        <div class="h">Tese de investimento</div>
                        <p>@(string.IsNullOrWhiteSpace(c.Tese) ? "Tese ainda não preenchida — comprador fora do cruzamento." : Curto(c.Tese, 300))</p>
                    </div>

                    <div class="lc-foot">
                        @if (!string.IsNullOrWhiteSpace(c.Site))
                        {
                            <a class="src" href="@(c.Site.StartsWith("http") ? c.Site : "https://" + c.Site)" target="_blank">🌐 site</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(c.Responsavel)) { <span class="src">resp.: @c.Responsavel</span> }
                        <div class="spacer"></div>
                        <a class="act" asp-controller="Comprador" asp-action="Editar" asp-route-id="@c.Id">Editar</a>
                        <a class="act" asp-controller="Comprador" asp-action="Alvos" asp-route-id="@c.Id">@matches alvo(s)</a>
                        <form asp-controller="Comprador" asp-action="Excluir" asp-route-id="@c.Id" method="post" class="inline-form"
                              onsubmit="return confirm('Excluir este comprador e seus cruzamentos? Esta ação não pode ser desfeita.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="act del" title="Excluir comprador" style="background:none;border:none;cursor:pointer;padding:0">Excluir</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>
