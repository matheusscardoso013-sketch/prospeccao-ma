@using ProspeccaoMA.Web.Util
@using ProspeccaoMA.Web.Models
@model List<ProspeccaoMA.Web.Models.SinergiaComprador>
@{
    var lead = (ProspeccaoMA.Web.Models.Lead)ViewData["Lead"]!;
    ViewData["Title"] = "Compradores compatíveis";
    string ClasseScore(int s) => s >= 70 ? "hi" : s >= 50 ? "mid" : "lo";
}

<div class="pagehead">
    <div>
        <h1>Compradores compatíveis</h1>
        @{
            var detalhes = string.Join(" · ", new[]
            {
                ProspeccaoMA.Web.Ingestao.CnpjUtil.Formatar(lead.Cnpj),
                string.IsNullOrWhiteSpace(lead.Cnae) ? null : $"CNAE {lead.Cnae}",
                lead.Segmento,
                string.IsNullOrWhiteSpace(lead.Uf) ? null : $"{lead.Municipio}/{lead.Uf}"
            }.Where(p => !string.IsNullOrWhiteSpace(p)));
        }
        <div class="sub">Sinergia entre <strong>@lead.RazaoSocial</strong> (@detalhes) e a tese de cada comprador.</div>
    </div>
    <div style="display:flex;gap:10px;align-self:center">
        @if (lead.Origem == ProspeccaoMA.Web.Models.Lead.OrigemValore)
        {
            <a class="btn ghost" asp-controller="Lead" asp-action="Editar" asp-route-id="@lead.Id">✏️ Editar alvo</a>
        }
        @if (Model.Count > 0)
        {
            <form asp-controller="Lead" asp-action="Recalcular" asp-route-id="@lead.Id" method="post" class="inline-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn primary">↻ Recalcular sinergias</button>
            </form>
        }
        <a class="btn ghost" asp-controller="Lead" asp-action="Index">← Voltar</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="vazio">Nenhum comprador aderente encontrado para o setor deste lead.</div>
}
else
{
    <div class="cards">
        @foreach (var s in Model)
        {
            var c = s.Comprador!;
            <div class="lead">
                <div class="lead-top">
                    <div class="scorebox @ClasseScore(s.Score)"><span class="n">@s.Score</span><span class="l">sinergia</span></div>
                    <div class="lead-id">
                        <div class="razao">@c.Nome</div>
                        @if (!string.IsNullOrWhiteSpace(c.RazaoSocial)) { <div class="cnpj">@c.RazaoSocial</div> }
                        <div class="tags">
                            @if (!string.IsNullOrWhiteSpace(c.TipoEmpresa)) { <span class="tag">@c.TipoEmpresa</span> }
                            @if (!string.IsNullOrWhiteSpace(c.FaixaFaturamento)) { <span class="tag gray">💰 @c.FaixaFaturamento</span> }
                        </div>
                    </div>
                </div>
                <div class="racional">
                    <div class="h">Racional da sinergia (IA)</div>
                    <p>@s.Racional</p>
                </div>
                <div class="lead-foot">
                    <span class="st-badge @StatusUi.Css(s.Status)">@StatusUi.Rotulo(s.Status)</span>
                    <form asp-controller="Sinergia" asp-action="Atualizar" asp-route-id="@s.Id" method="post" class="statusform" style="flex:1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="voltar" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <select name="status">
                            @foreach (var st in StatusUi.Todos)
                            {
                                <option value="@((int)st)" selected="@(s.Status == st)">@StatusUi.Rotulo(st)</option>
                            }
                        </select>
                        <input type="text" name="anotacoes" value="@s.Anotacoes" placeholder="anotações…" />
                        <button type="submit" class="btn ghost sm">💾</button>
                    </form>
                    <a class="btn ghost sm" asp-controller="Comprador" asp-action="Alvos" asp-route-id="@c.Id">Tese/alvos</a>
                </div>
            </div>
        }
    </div>
}
