@using ProspeccaoMA.Web.Models.ViewModels
@model LeadsViewModel
@{
    ViewData["Title"] = "Leads";
    string Inv(double v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);
    double Dash(int s) => System.Math.Round(100.5 * s / 100.0, 1);
    string CorScore(int s) => s >= 80 ? "teal" : s >= 60 ? "bronze" : "muted";

    string UrlAba(AbaLeads a) => Url.Action("Index", "Lead", new { aba = a, busca = Model.Busca })!;
    string UrlPagina(int p) => Url.Action("Index", "Lead", new
    {
        aba = Model.Aba, busca = Model.Busca, cnae = Model.Cnae, uf = Model.Uf,
        scoreMin = Model.ScoreMin, ordenar = Model.Ordenar, pagina = p
    })!;
}

<div class="lead-wrap">
    <div class="lead-head">
        <div>
            <div class="px-ey">Prospecção</div>
            <h1 class="px-h1">Leads</h1>
            <div class="px-sub">@Model.TotalLeads.ToString("N0") empresas reais na base · @Model.GeradosHoje pontuadas hoje · última execução @(Model.UltimaExecucao is null ? "—" : ProspeccaoMA.Web.Util.Fuso.Brasil(Model.UltimaExecucao.IniciadoEm).ToString("dd/MM HH:mm") + " · " + Model.UltimaExecucao.Status)</div>
        </div>
        <div class="fa-acts">
            <a class="fa-btn s" asp-controller="Lead" asp-action="Importar">+ Importar CNPJs</a>
            <form asp-controller="Lead" asp-action="RodarAgora" method="post" class="inline-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="fa-btn p">Rodar prospecção agora</button>
            </form>
        </div>
    </div>

    <div class="rz-tabs">
        <a class="rz-tab @(Model.Aba == AbaLeads.Valore ? "on" : "")" href="@UrlAba(AbaLeads.Valore)">★ Alvos Valore · @Model.TotalValore</a>
        <a class="rz-tab @(Model.Aba == AbaLeads.Receita ? "on" : "")" href="@UrlAba(AbaLeads.Receita)">Pool Receita · @Model.TotalReceita.ToString("N0")</a>
        <a class="rz-tab @(Model.Aba == AbaLeads.Quentes ? "on" : "")" href="@UrlAba(AbaLeads.Quentes)">Com comprador quente · @Model.TotalQuentes</a>
    </div>

    <form method="get" asp-controller="Lead" asp-action="Index" class="lf">
        <input type="hidden" name="aba" value="@Model.Aba" />
        <div class="field" style="flex:1;min-width:200px">
            <label>Buscar por nome</label>
            <input type="text" name="busca" value="@Model.Busca" placeholder="razão social da empresa…" style="width:100%" />
        </div>
        <div class="field">
            <label>Setor</label>
            <select name="cnae">
                <option value="">Todos</option>
                @foreach (var c in Model.Cnaes)
                {
                    <option value="@c" selected="@(c == Model.Cnae)">@c — @(ProspeccaoMA.Web.Util.CnaeCatalogo.Rotulo(c, 40))</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Score mín.</label>
            <select name="scoreMin">
                <option value="">Qualquer</option>
                <option value="70" selected="@(Model.ScoreMin == 70)">70+</option>
                <option value="50" selected="@(Model.ScoreMin == 50)">50+</option>
            </select>
        </div>
        <div class="field">
            <label>Ordenar</label>
            <select name="ordenar">
                <option value="Score" selected="@(Model.Ordenar == OrdenacaoLeads.Score)">Maior score</option>
                <option value="Sinergia" selected="@(Model.Ordenar == OrdenacaoLeads.Sinergia)">Melhor sinergia</option>
                <option value="Capital" selected="@(Model.Ordenar == OrdenacaoLeads.Capital)">Maior capital</option>
                <option value="Recente" selected="@(Model.Ordenar == OrdenacaoLeads.Recente)">Mais recente</option>
            </select>
        </div>
        <button type="submit" class="fa-btn s">Filtrar</button>
        <div class="spacer"></div>
        <a class="fa-btn s" asp-controller="Lead" asp-action="Exportar"
           asp-route-cnae="@Model.Cnae" asp-route-uf="@Model.Uf" asp-route-scoreMin="@Model.ScoreMin" asp-route-ordenar="@Model.Ordenar">
            ⬇ Exportar Excel
        </a>
    </form>

    @if (Model.Leads.Count == 0)
    {
        <div class="lead-vazio">
            Nenhuma empresa neste recorte. Ajuste a busca/filtros ou troque de aba —
            a prospecção diária alimenta a base automaticamente.
        </div>
    }
    else
    {
        <div class="rz-count">@Model.TotalResultados.ToString("N0") resultado(s) · página @Model.Pagina de @Model.TotalPaginas</div>
        <div class="rz-list">
            @foreach (var x in Model.Leads)
            {
                var l = x.Lead;
                var pendente = x.Score == 0;
                <details class="lcx">
                    <summary class="lcx-row">
                        @if (pendente)
                        {
                            <span class="lcx-sc m">—</span>
                        }
                        else
                        {
                            <span class="lcx-sc @CorScore(x.Score)">@x.Score</span>
                        }
                        <span class="lcx-co">
                            <span class="nm">@l.RazaoSocial</span>
                            <span class="st">
                                @(string.IsNullOrWhiteSpace(l.Segmento) ? ProspeccaoMA.Web.Util.CnaeCatalogo.Rotulo(l.Cnae, 40) : l.Segmento)
                                @if (!string.IsNullOrWhiteSpace(l.Uf)) { <text> · @l.Uf</text> }
                                @if (x.MelhorComprador is not null) { <text> · melhor fit: <b>@x.MelhorComprador</b></text> }
                            </span>
                        </span>
                        @if (x.MelhorSinergiaScore >= 80) { <span class="rz-chip hot">comprador @x.MelhorSinergiaScore</span> }
                        else if (x.MelhorSinergiaScore >= 60) { <span class="rz-chip novo">comprador @x.MelhorSinergiaScore</span> }
                        else if (pendente) { <span class="rz-chip pend">@(l.Origem == ProspeccaoMA.Web.Models.Lead.OrigemValore ? "pendente" : "no radar")</span> }
                        <span class="lcx-arrow">▾</span>
                    </summary>
                    <div class="lcx-body">
                        <div class="lc-tags" style="margin-bottom:12px">
                            @if (l.Origem == ProspeccaoMA.Web.Models.Lead.OrigemValore) { <span class="lc-tag cur">★ Curado Valore</span> }
                            @if (l.EditadoManualmente) { <span class="lc-tag">✎ editado</span> }
                            @{ var cnpjFmt = ProspeccaoMA.Web.Ingestao.CnpjUtil.Formatar(l.Cnpj); }
                            @if (!string.IsNullOrWhiteSpace(cnpjFmt)) { <span class="lc-tag">@cnpjFmt</span> }
                            @if (!string.IsNullOrWhiteSpace(l.Municipio)) { <span class="lc-tag">@l.Municipio/@l.Uf</span> }
                            @if (!string.IsNullOrWhiteSpace(l.Situacao)) { <span class="lc-tag on">● @l.Situacao</span> }
                            <span class="lc-tag">score: @x.RotuloScore</span>
                        </div>
                        <div class="lc-facts" style="margin-top:0">
                            @if (l.CapitalSocial > 0)
                            {
                                <div class="lc-fr"><span class="k">Capital social</span><span class="v">@l.CapitalSocial.ToString("C0")</span></div>
                            }
                            <div class="lc-fr"><span class="k">@(l.Origem == ProspeccaoMA.Web.Models.Lead.OrigemValore ? "Faturamento (est.)" : "Porte (est.)")</span><span class="v est">@l.PorteEstimado</span></div>
                            @if (!string.IsNullOrWhiteSpace(l.ValuationEstimado))
                            {
                                <div class="lc-fr"><span class="k">Valuation (est.)</span><span class="v est">@l.ValuationEstimado</span></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(l.MargemEbitda))
                            {
                                <div class="lc-fr"><span class="k">Margem EBITDA</span><span class="v est">@l.MargemEbitda</span></div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(l.Contato))
                        {
                            <div class="lc-ct">
                                <div class="h">Contatos</div>
                                @foreach (var parte in l.Contato.Split(" | ", StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <div class="row">@parte</div>
                                }
                            </div>
                        }
                        <div class="lc-rac">
                            <div class="h">@(pendente && !string.IsNullOrWhiteSpace(l.Descricao) ? "Resumo da empresa (base Valore)" : "Racional da IA")</div>
                            <p>@(pendente && !string.IsNullOrWhiteSpace(l.Descricao)
                                ? (l.Descricao.Length > 320 ? l.Descricao.Substring(0, 320) + "…" : l.Descricao)
                                : x.Racional)</p>
                        </div>
                        <div class="lc-foot">
                            <span class="src">Fonte: @x.Fonte · @ProspeccaoMA.Web.Util.Fuso.Brasil(x.GeradoEm).ToString("dd/MM")</span>
                            @if (!string.IsNullOrWhiteSpace(l.Site))
                            {
                                <a class="src" href="@(l.Site.StartsWith("http") ? l.Site : "https://" + l.Site)" target="_blank">🌐 site</a>
                            }
                            <div class="spacer"></div>
                            <a class="act" asp-controller="Lead" asp-action="Editar" asp-route-id="@l.Id">Editar</a>
                            <a class="act" asp-controller="Lead" asp-action="Compradores" asp-route-id="@l.Id">Ficha e compradores</a>
                            <form asp-controller="Lead" asp-action="Excluir" asp-route-id="@l.Id" method="post" class="inline-form"
                                  onsubmit="return confirm('Excluir esta empresa e seus cruzamentos? Esta ação não pode ser desfeita.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="act del" style="background:none;border:none;cursor:pointer;padding:0">Excluir</button>
                            </form>
                        </div>
                    </div>
                </details>
            }
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <div class="rz-pager">
                @if (Model.Pagina > 1) { <a class="fa-btn s" href="@UrlPagina(Model.Pagina - 1)">← Anterior</a> }
                <span class="pg">página @Model.Pagina de @Model.TotalPaginas</span>
                @if (Model.Pagina < Model.TotalPaginas) { <a class="fa-btn s" href="@UrlPagina(Model.Pagina + 1)">Próxima →</a> }
            </div>
        }
    }
</div>
