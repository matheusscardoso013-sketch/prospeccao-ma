@using ProspeccaoMA.Web.Models.ViewModels
@model LeadsViewModel
@{
    ViewData["Title"] = "Leads";
    string ClasseScore(int s) => s >= 70 ? "hi" : s >= 50 ? "mid" : "lo";
}

<div class="pagehead">
    <div>
        <h1>Leads prospectados</h1>
        <div class="sub">Empresas reais da base da Receita Federal, pontuadas por sinergia setorial.</div>
    </div>
    <div style="display:flex;gap:10px">
        <a class="btn ghost" asp-controller="Lead" asp-action="Importar">+ Importar CNPJs</a>
        <form asp-controller="Lead" asp-action="RodarAgora" method="post" class="inline-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn primary">▶ Rodar prospecção agora</button>
        </form>
    </div>
</div>

<div class="kpis">
    <div class="kpi"><div class="label">Leads no total</div><div class="value">@Model.TotalLeads</div></div>
    <div class="kpi"><div class="label">Pontuados hoje</div><div class="value">@Model.GeradosHoje</div></div>
    <div class="kpi ok">
        <div class="label">Última execução</div>
        <div class="value">
            @if (Model.UltimaExecucao is null)
            {
                <span>— nenhuma ainda</span>
            }
            else
            {
                var ex = Model.UltimaExecucao;
                var clsDot = ex.Status == ProspeccaoMA.Web.Models.StatusExecucao.Erro ? "dot err" : "dot";
                <span class="@clsDot"></span>@ex.IniciadoEm.ToLocalTime().ToString("dd/MM HH:mm") <small>· @ex.Status</small>
            }
        </div>
    </div>
    <div class="kpi"><div class="label">Score médio (filtro)</div><div class="value">@Model.ScoreMedio<small>/100</small></div></div>
</div>

<form method="get" asp-controller="Lead" asp-action="Index" class="toolbar">
    <div class="field">
        <label>Setor (CNAE)</label>
        <select name="cnae">
            <option value="">Todos</option>
            @foreach (var c in Model.Cnaes)
            {
                <option value="@c" selected="@(c == Model.Cnae)">@c</option>
            }
        </select>
    </div>
    <div class="field">
        <label>UF</label>
        <select name="uf">
            <option value="">Todas</option>
            @foreach (var u in Model.Ufs)
            {
                <option value="@u" selected="@(u == Model.Uf)">@u</option>
            }
        </select>
    </div>
    <div class="field">
        <label>Score mínimo</label>
        <select name="scoreMin">
            <option value="">Qualquer</option>
            <option value="70" selected="@(Model.ScoreMin == 70)">70+</option>
            <option value="50" selected="@(Model.ScoreMin == 50)">50+</option>
        </select>
    </div>
    <div class="field">
        <label>Ordenar por</label>
        <select name="ordenar">
            <option value="Score" selected="@(Model.Ordenar == OrdenacaoLeads.Score)">Maior score</option>
            <option value="Capital" selected="@(Model.Ordenar == OrdenacaoLeads.Capital)">Maior capital</option>
            <option value="Recente" selected="@(Model.Ordenar == OrdenacaoLeads.Recente)">Mais recente</option>
        </select>
    </div>
    <button type="submit" class="btn ghost">Filtrar</button>
    <div class="spacer"></div>
    <a class="btn green" asp-controller="Lead" asp-action="Exportar"
       asp-route-cnae="@Model.Cnae" asp-route-uf="@Model.Uf" asp-route-scoreMin="@Model.ScoreMin" asp-route-ordenar="@Model.Ordenar">
        ⬇ Exportar Excel
    </a>
</form>

@if (Model.Leads.Count == 0)
{
    <div class="vazio">
        Nenhum lead pontuado ainda. Importe CNPJs reais e rode a prospecção —
        ou aguarde o job das 12h. A IA só pontua empresas reais já trazidas pela base.
    </div>
}
else
{
    <div class="cards">
        @foreach (var x in Model.Leads)
        {
            var l = x.Lead;
            <div class="lead">
                <div class="lead-top">
                    <div class="scorebox @ClasseScore(x.Score)">
                        <span class="n">@x.Score</span><span class="l">sinergia</span>
                    </div>
                    <div class="lead-id">
                        <div class="razao">@l.RazaoSocial</div>
                        @{ var cnpjFmt = ProspeccaoMA.Web.Ingestao.CnpjUtil.Formatar(l.Cnpj); }
                        @if (!string.IsNullOrWhiteSpace(cnpjFmt)) { <div class="cnpj">@cnpjFmt</div> }
                        <div class="tags">
                            @if (l.Origem == ProspeccaoMA.Web.Models.Lead.OrigemValore) { <span class="tag ativa">★ Curado Valore</span> }
                            @if (l.EditadoManualmente) { <span class="tag gray">✎ editado</span> }
                            @if (!string.IsNullOrWhiteSpace(l.Cnae)) { <span class="tag">CNAE @l.Cnae</span> }
                            @if (!string.IsNullOrWhiteSpace(l.Segmento)) { <span class="tag">@l.Segmento</span> }
                            @if (!string.IsNullOrWhiteSpace(l.Uf)) { <span class="tag gray">📍 @l.Municipio/@l.Uf</span> }
                            @if (!string.IsNullOrWhiteSpace(l.Situacao)) { <span class="tag ativa">● @l.Situacao</span> }
                        </div>
                    </div>
                </div>

                <div class="lead-grid">
                    @if (l.CapitalSocial > 0)
                    {
                        <div class="cell"><div class="k">Capital social</div><div class="v">@l.CapitalSocial.ToString("C")</div></div>
                    }
                    <div class="cell"><div class="k">@(l.Origem == ProspeccaoMA.Web.Models.Lead.OrigemValore ? "Faturamento (est.)" : "Porte estimado")</div><div class="v est">@l.PorteEstimado</div></div>
                    @if (!string.IsNullOrWhiteSpace(l.ValuationEstimado))
                    {
                        <div class="cell"><div class="k">Valuation (est.)</div><div class="v est">@l.ValuationEstimado</div></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(l.MargemEbitda))
                    {
                        <div class="cell"><div class="k">Margem EBITDA (est.)</div><div class="v est">@l.MargemEbitda</div></div>
                    }
                </div>

                <div class="contatos">
                    <div class="h">Contatos (cadastro / enriquecimento)</div>
                    @if (string.IsNullOrWhiteSpace(l.Contato))
                    {
                        <div class="ct missing"><span class="ico">✉️</span> Contato não consta no cadastro</div>
                    }
                    else
                    {
                        foreach (var parte in l.Contato.Split(" | ", StringSplitOptions.RemoveEmptyEntries))
                        {
                            <div class="ct"><span class="ico">•</span> @parte</div>
                        }
                    }
                </div>

                @{ var aindaNaoCruzado = x.Racional.StartsWith("Ainda não cruzado"); }
                @if (aindaNaoCruzado && !string.IsNullOrWhiteSpace(l.Descricao))
                {
                    <div class="racional">
                        <div class="h">Resumo da empresa (base Valore)</div>
                        <p>@(l.Descricao.Length > 320 ? l.Descricao.Substring(0, 320) + "…" : l.Descricao)</p>
                    </div>
                }
                else
                {
                    <div class="racional">
                        <div class="h">Racional da IA</div>
                        <p>@x.Racional</p>
                    </div>
                }

                <div class="lead-foot">
                    <span class="src">Fonte: @x.Fonte</span>
                    @if (!string.IsNullOrWhiteSpace(l.Site))
                    {
                        <a class="src" href="@(l.Site.StartsWith("http") ? l.Site : "https://" + l.Site)" target="_blank">🌐 site</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(l.Responsavel)) { <span class="ger">resp.: @l.Responsavel</span> }
                    <div class="spacer"></div>
                    <span class="ger">@x.GeradoEm.ToLocalTime().ToString("dd/MM HH:mm")</span>
                    <a class="btn ghost sm" asp-controller="Lead" asp-action="Editar" asp-route-id="@l.Id">✏️ Editar</a>
                    <a class="btn ghost sm" asp-controller="Lead" asp-action="Compradores" asp-route-id="@l.Id">🎯 Compradores</a>
                </div>
            </div>
        }
    </div>
}
