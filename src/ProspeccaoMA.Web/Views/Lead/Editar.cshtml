@model ProspeccaoMA.Web.Models.Lead
@{
    ViewData["Title"] = "Editar alvo";
}

@{
    var ehReceita = Model.Origem == ProspeccaoMA.Web.Models.Lead.OrigemReceita;
}
<div class="lead-wrap">
<div class="lead-head">
    <div>
        <div class="px-ey">Editar alvo</div>
        <h1 class="px-h1">Editar empresa</h1>
        <div class="px-sub">O resumo e o segmento alimentam o cruzamento com os compradores. Valores estimados continuam exibidos com "~".</div>
    </div>
    <a class="fa-btn s" style="align-self:flex-start" asp-controller="Lead" asp-action="Index">← Voltar aos leads</a>
</div>

@if (ehReceita)
{
    <div class="ro-box">
        <div class="ro-h">Dados oficiais da Receita Federal — não editáveis (preservam a rastreabilidade da fonte)</div>
        <div class="lc-tags">
            <span class="lc-tag">CNPJ @ProspeccaoMA.Web.Ingestao.CnpjUtil.Formatar(Model.Cnpj)</span>
            @if (!string.IsNullOrWhiteSpace(Model.Cnae)) { <span class="lc-tag">CNAE @Model.Cnae</span> }
            @if (!string.IsNullOrWhiteSpace(Model.Uf)) { <span class="lc-tag">@Model.Municipio/@Model.Uf</span> }
            @if (Model.CapitalSocial > 0) { <span class="lc-tag">Capital @Model.CapitalSocial.ToString("C0")</span> }
            @if (!string.IsNullOrWhiteSpace(Model.Situacao)) { <span class="lc-tag on">● @Model.Situacao</span> }
        </div>
    </div>
}

<form asp-controller="Lead" asp-action="SalvarLead" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="alert err" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <div class="formgrid">
        <div class="field full">
            <label>Razão social / nome</label>
            <input type="text" asp-for="RazaoSocial" />
        </div>
        <div class="field full">
            <label>Segmento</label>
            <input type="text" asp-for="Segmento" placeholder="ex.: Tech Software (SaaS, aplicativos)" />
        </div>
        <div class="field">
            <label>Faturamento estimado</label>
            <input type="text" asp-for="PorteEstimado" placeholder="~ R$ 10.000.000" />
        </div>
        <div class="field">
            <label>Valuation estimado</label>
            <input type="text" asp-for="ValuationEstimado" placeholder="~ R$ 50.000.000" />
        </div>
        <div class="field">
            <label>Margem EBITDA</label>
            <input type="text" asp-for="MargemEbitda" placeholder="~ 15%" />
        </div>
        <div class="field">
            <label>Responsável (Valore)</label>
            <input type="text" asp-for="Responsavel" />
        </div>
        <div class="field full">
            <label>Site</label>
            <input type="text" asp-for="Site" />
        </div>
        <div class="field full">
            <label>Contatos</label>
            <textarea asp-for="Contato" style="min-height:80px" placeholder="Nome — e-mail — telefone (um por linha)"></textarea>
        </div>
        <div class="field">
            <label>Modelo de negócio</label>
            <input type="text" asp-for="ModeloNegocio" placeholder="SaaS B2B recorrente; indústria; serviços…" />
        </div>
        <div class="field">
            <label>Abrangência</label>
            <select asp-for="Abrangencia">
                <option value="">(não definida)</option>
                <option>Local</option>
                <option>Regional</option>
                <option>Nacional</option>
                <option>Internacional</option>
            </select>
        </div>
        <div class="field full">
            <label>Cultura / gestão</label>
            <textarea asp-for="Cultura" style="min-height:60px" placeholder="ex.: gestão familiar, fundador quer permanecer; equipe profissionalizada…"></textarea>
        </div>
        <div class="field full">
            <label>Resumo da empresa (usado pela IA no cruzamento)</label>
            <textarea asp-for="Descricao" style="min-height:180px" placeholder="O que a empresa faz, produtos, clientes, diferenciais, motivação de venda…"></textarea>
        </div>
        <div class="full">
            <button type="submit" class="fa-btn p">Salvar alvo</button>
        </div>
    </div>
</form>
</div>
