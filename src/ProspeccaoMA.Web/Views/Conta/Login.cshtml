@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Entrar · Prospecção M&A</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="login-page">
  <div class="login-card">
    <div class="login-side">
      <div class="brand"><span class="logo">◆</span> Prospecção M&amp;A</div>
      <h2>Leads reais de M&amp;A,<br>qualificados por IA.</h2>
      <p>Prospecção diária automática a partir da base pública da Receita Federal.
         A IA pontua a sinergia — nunca inventa empresas.</p>
      <span class="pill">● Atualizado todo dia às 12h</span>
    </div>
    <div class="login-form">
      <h3>Entrar</h3>
      <div class="sub">Acesse o painel de prospecção</div>
      <form asp-controller="Conta" asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <div asp-validation-summary="All" class="alert err" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>
        <div class="field">
          <label>E-mail</label>
          <input type="text" name="email" autofocus />
        </div>
        <div class="field">
          <label>Senha</label>
          <input type="password" name="senha" />
        </div>
        <button class="btn primary" type="submit">Entrar</button>
      </form>
    </div>
  </div>
</div>
</body>
</html>
