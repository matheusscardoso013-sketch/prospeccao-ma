@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Entrar · Valore Brasil — Originação M&A</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="login-page">
  <div class="login-card">
    <div class="login-side">
      <div class="vb-logo clara">
        <span class="v" style="font-size:30px">valore</span>
        <span class="b"><span class="tri"></span><span class="brasil" style="font-size:15px">BRASIL</span></span>
      </div>
      <h2>Decisões inteligentes em<br>fusões &amp; aquisições.</h2>
      <p>Prospecção diária de alvos reais e sinergias com nossa base de compradores,
         qualificadas por inteligência artificial.</p>
      <span class="pill">● Atualizado todo dia às 12h</span>
    </div>
    <div class="login-form">
      <h3>Entrar</h3>
      <div class="sub">Acesse a plataforma de originação</div>
      <form asp-controller="Conta" asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <div asp-validation-summary="All" class="alert err" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>
        <div class="field">
          <label>E-mail</label>
          <input type="text" name="email" autofocus />
        </div>
        <div class="field">
          <label>Senha</label>
          <input type="password" name="senha" />
        </div>
        <button class="btn primary" type="submit">Entrar</button>
      </form>
    </div>
  </div>
</div>
</body>
</html>
