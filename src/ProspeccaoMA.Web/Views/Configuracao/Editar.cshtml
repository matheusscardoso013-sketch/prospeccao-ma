@model ProspeccaoMA.Web.Models.ConfiguracaoProspeccao
@{
    ViewData["Title"] = Model.Id == 0 ? "Nova configuração" : "Editar configuração";
}

<div class="lead-wrap">
<div class="lead-head">
    <div>
        <div class="px-ey">Prospecção</div>
        <h1 class="px-h1">@ViewData["Title"]</h1>
        <div class="px-sub">A descoberta de empresas vem SÓ destes CNAEs/UFs na base da Receita. A IA não cria empresas.</div>
    </div>
    <a class="fa-btn s" style="align-self:flex-start" asp-controller="Configuracao" asp-action="Index">← Voltar</a>
</div>

<form asp-controller="Configuracao" asp-action="Salvar" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="alert err" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <div class="formgrid">
        <div class="field full">
            <label>CNAEs alvo (separados por vírgula)</label>
            <input type="text" asp-for="Cnaes" placeholder="2110-6, 2019-3, 4644-3" />
            <div class="hint">Aceita com ou sem pontuação. Casa por classe (prefixo) ou subclasse completa.</div>
        </div>
        <div class="field">
            <label>UFs alvo (separadas por vírgula)</label>
            <input type="text" asp-for="Ufs" placeholder="SP, MG, DF" />
        </div>
        <div class="field">
            <label>Status</label>
            <select asp-for="Ativo">
                <option value="true">Ativa (entra na rotina diária)</option>
                <option value="false">Inativa</option>
            </select>
        </div>
        <div class="field">
            <label>Capital social mínimo (R$)</label>
            <input type="number" step="0.01" asp-for="CapitalMin" placeholder="5000000" />
        </div>
        <div class="field">
            <label>Capital social máximo (R$)</label>
            <input type="number" step="0.01" asp-for="CapitalMax" placeholder="100000000" />
        </div>
        <div class="full">
            <button type="submit" class="fa-btn p">Salvar configuração</button>
        </div>
    </div>
</form>
</div>
