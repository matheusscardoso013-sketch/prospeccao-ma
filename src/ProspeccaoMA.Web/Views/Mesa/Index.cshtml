@using ProspeccaoMA.Web.Models
@using ProspeccaoMA.Web.Util
@model List<ProspeccaoMA.Web.Models.SinergiaComprador>
@{
    ViewData["Title"] = "Mesa de operações";
    var kpis = (Dictionary<StatusSinergia, int>)ViewData["Kpis"]!;
    int K(StatusSinergia s) => kpis.TryGetValue(s, out var n) ? n : 0;
    var statusAtual = (StatusSinergia?)ViewData["Status"];
    string CorScore(int s) => s >= 80 ? "teal" : s >= 60 ? "bronze" : "muted";
}

<div class="lead-wrap">
    <div class="lead-head">
        <div>
            <div class="px-ey">Mesa de operações</div>
            <h1 class="px-h1">Pares alvo × comprador</h1>
            <div class="px-sub">Os melhores pares em aberto, ordenados por score. Atualize o status conforme o time trabalha.</div>
        </div>
    </div>

    <div class="px-kpis" style="grid-template-columns:repeat(5,1fr)">
        <div class="px-kpi"><div class="l">Novos</div><div class="n">@K(StatusSinergia.Novo)</div></div>
        <div class="px-kpi"><div class="l">Abordados</div><div class="n">@K(StatusSinergia.Abordado)</div></div>
        <div class="px-kpi"><div class="l">Reunião</div><div class="n">@K(StatusSinergia.Reuniao)</div></div>
        <div class="px-kpi"><div class="l">Em negociação</div><div class="n">@K(StatusSinergia.EmNegociacao)</div></div>
        <div class="px-kpi"><div class="l">Descartados</div><div class="n">@K(StatusSinergia.Descartado)</div></div>
    </div>

    <form method="get" asp-controller="Mesa" asp-action="Index" class="lf">
        <div class="field">
            <label>Status</label>
            <select name="status">
                <option value="">Em aberto (todos)</option>
                @foreach (var s in StatusUi.Todos)
                {
                    <option value="@((int)s)" selected="@(statusAtual == s)">@StatusUi.Rotulo(s)</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Score mínimo</label>
            <select name="scoreMin">
                <option value="">Qualquer</option>
                <option value="70" selected="@((int?)ViewData["ScoreMin"] == 70)">70+</option>
                <option value="50" selected="@((int?)ViewData["ScoreMin"] == 50)">50+</option>
            </select>
        </div>
        <div class="field" style="flex:1">
            <label>Buscar</label>
            <input type="text" name="busca" value="@ViewData["Busca"]" placeholder="alvo, comprador ou responsável" style="width:100%" />
        </div>
        <button type="submit" class="fa-btn s">Filtrar</button>
    </form>

    @if (Model.Count == 0)
    {
        <div class="lead-vazio">Nenhum match neste filtro. Os pares surgem conforme a prospecção diária cruza alvos e compradores.</div>
    }
    else
    {
        <div class="mesa-panel">
            <table class="mtable">
                <thead>
                    <tr><th>Score</th><th>Alvo</th><th>Comprador</th><th>Resp.</th><th style="width:320px">Status / anotações</th><th>Atualizado</th></tr>
                </thead>
                <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td><span class="m-score @CorScore(s.Score)">@s.Score</span></td>
                        <td>
                            <a class="m-name" asp-controller="Lead" asp-action="Compradores" asp-route-id="@s.LeadId">@s.Lead?.RazaoSocial</a>
                            <div class="m-sub">@(s.Lead?.Segmento ?? s.Lead?.Cnae)</div>
                        </td>
                        <td>
                            <a class="m-name" asp-controller="Comprador" asp-action="Alvos" asp-route-id="@s.CompradorId">@s.Comprador?.Nome</a>
                            <div class="m-sub">@s.Comprador?.TipoEmpresa</div>
                        </td>
                        <td class="m-resp">@s.Comprador?.Responsavel</td>
                        <td>
                            <form asp-controller="Sinergia" asp-action="Atualizar" asp-route-id="@s.Id" method="post" class="m-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="voltar" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <select name="status">
                                    @foreach (var st in StatusUi.Todos)
                                    {
                                        <option value="@((int)st)" selected="@(s.Status == st)">@StatusUi.Rotulo(st)</option>
                                    }
                                </select>
                                <input type="text" name="anotacoes" value="@s.Anotacoes" placeholder="anotações…" />
                                <button type="submit" class="fa-btn s" style="padding:6px 11px">Salvar</button>
                            </form>
                        </td>
                        <td class="m-upd">@(s.AtualizadoEm is null ? "—" : Fuso.Brasil(s.AtualizadoEm.Value).ToString("dd/MM HH:mm"))</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
